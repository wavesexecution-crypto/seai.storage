# SEAI Storage — environment template.
# Copy to .env for local development. NEVER commit real secrets.

# --- Server ---
PORT=4100
NODE_ENV=development
LOG_LEVEL=info

# --- Database (PostgreSQL metadata) ---
# Local dev via docker-compose (see docker-compose.yml):
DATABASE_URL=postgresql://seai_storage:seai_storage_dev@localhost:5434/seai_storage

# --- Auth ---
# HS256 secret for verifying user JWTs issued by CDF/auth system.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STORAGE_JWT_SECRET=dev-only-change-me-min-32-chars
# Comma-separated service credentials, format name:key,name:key (server-side only).
# Example: SERVICE_API_KEYS=cdf:dev-cdf-key,intake:dev-intake-key
SERVICE_API_KEYS=cdf:dev-cdf-key

# --- Storage provider ---
# memory | local | s3
STORAGE_PROVIDER=local
# Used by local provider (dev only):
LOCAL_STORAGE_DIR=./data/objects
LOCAL_PUBLIC_BASE_URL=http://localhost:4100
# Used by s3 provider (S3-compatible; works with MinIO):
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=seai-storage-dev
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=seai-storage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=

# --- URLs / TTLs ---
# TTL for signed upload URLs (seconds). Keep short.
UPLOAD_URL_TTL_SECONDS=900
# TTL for signed download URLs (seconds). Keep short.
STORAGE_SIGNED_URL_TTL_SECONDS=300
# Days to retain soft-deleted metadata before purge is allowed.
RETENTION_DAYS=30
# Set to true only when a real malware scanner is wired in (see docs/MALWARE_SCANNING.md).
SCANNER_ENABLED=false

# --- Limits (bytes) ---
MAX_FILE_SIZE_BYTES=26214400
MAX_IMAGE_SIZE_BYTES=10485760
MAX_DOCUMENT_SIZE_BYTES=15728640
MAX_VIDEO_SIZE_BYTES=104857600
MAX_FONT_SIZE_BYTES=5242880

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_UPLOADS=30
RATE_LIMIT_MAX_DOWNLOADS=120
RATE_LIMIT_MAX_DELETES=30

# --- Public assets ---
# Base URL used to construct publicUrl for PUBLIC assets (CDN origin). Empty = not configured.
PUBLIC_BASE_URL=
